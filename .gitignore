# ═══════════════════════════════════════════════
# WalletKu .gitignore
# Keep encrypted data and secrets off version control
# ═══════════════════════════════════════════════

# ── BACKUP FILES ──────────────────────────────
*.bak
WalletKu_backup_*.json
WalletKu_*.png

# ── OS FILES ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── EDITOR / IDE ──────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── NODE (if you ever add a build step) ───────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# ── BUILD OUTPUT ──────────────────────────────
dist/
build/
.cache/
.parcel-cache/

# ── ENVIRONMENT / SECRETS ─────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets.json
config.local.js

# ── LOGS ──────────────────────────────────────
*.log
logs/

# ── TEMP ──────────────────────────────────────
tmp/
temp/
*.tmp

# ─────────────────────────────────────────────
# SECURITY NOTE:
# WalletKu stores all data in the BROWSER's localStorage.
# No server-side data is ever written to disk by this app.
# What IS safe to commit: index.html, style.css, app.js, changelogs.md
# What should NOT be committed: any exported backup JSON files,
# exported PNG snapshots, or any .env files if you add a backend.
# ─────────────────────────────────────────────
